name = "Nanaloveyuki/orbit"

version = "0.2.0-alpha.2"

description = "Composable desktop application foundations for MoonBit."

repository = "https://github.com/Nanaloveyuki/orbit"

license = "Apache-2.0"

readme = "README.md"

keywords = [ "desktop", "webview", "ipc", "moonbit" ]

preferred_target = "native"

import {
  "gmlewis/sha256@0.18.0",
  "Nanaloveyuki/ajni@0.3.5",
  "Nanaloveyuki/BitLogger@0.9.2",
  "Nanaloveyuki/parsec@0.1.6",
  "Nanaloveyuki/moonview@0.1.0-beta.13",
  "Nanaloveyuki/sync@0.7.4",
  "Nanaloveyuki/orby@0.1.0-beta.8",
  "moonbitlang/async@0.22.4",
  "Nanaloveyuki/dynlib@0.2.3",
  "Nanaloveyuki/orbit-plugin-abi@0.2.5",
  "Nanaloveyuki/image@0.1.4",
  "moonbit-community/proton_clipboard@0.3.3",
  "moonbit-community/proton_global_hotkey@0.3.3",
  "moonbit-community/proton_safe_storage@0.3.3",
  "moonbit-community/proton_shell@0.3.3",
  "moonbit-community/proton_auto_launch@0.3.3",
  "moonbit-community/proton_keepawake@0.3.3",
  "moonrockz/directories@0.1.1",
}
