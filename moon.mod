name = "Nanaloveyuki/orbit"

version = "0.2.0-alpha.3"

description = "Composable desktop application foundations for MoonBit."

repository = "https://github.com/Nanaloveyuki/orbit"

license = "Apache-2.0"

readme = "README.md"

keywords = [ "desktop", "webview", "ipc", "moonbit" ]

preferred_target = "native"

import {
  "gmlewis/sha256@0.18.2",
  "Nanaloveyuki/ajni@0.3.8",
  "Nanaloveyuki/BitLogger@0.11.2",
  "Nanaloveyuki/parsec@0.1.7",
  "Nanaloveyuki/moonview@0.1.0-beta.14",
  "Nanaloveyuki/sync@0.7.5",
  "Nanaloveyuki/orby@0.1.0-beta.9",
  "moonbitlang/async@0.22.9",
  "moonbitlang/x@0.5.7",
  "Nanaloveyuki/dynlib@0.2.4",
  "Nanaloveyuki/orbit-plugin-abi@0.2.6",
  "Nanaloveyuki/image@0.1.5",
  "moonbit-community/proton_clipboard@0.9.0",
  "moonbit-community/proton_global_hotkey@0.9.0",
  "moonbit-community/proton_safe_storage@0.9.0",
  "moonbit-community/proton_shell@0.9.0",
  "moonbit-community/proton_auto_launch@0.9.0",
  "moonbit-community/proton_keepawake@0.9.0",
  "moonrockz/directories@0.1.2",
}
