  "Nanaloveyuki/ajni@0.2.4",
  "Nanaloveyuki/BitLogger@0.8.2",
  "Nanaloveyuki/parsec@0.1.4",
  "Nanaloveyuki/moonview@0.1.0-beta.11",
  "Nanaloveyuki/sync@0.7.2",
  "Nanaloveyuki/orby@0.1.0-beta.6",
  "moonbitlang/async@0.22.4",
  "Nanaloveyuki/dynlib@0.2.1",
  "Nanaloveyuki/orbit-plugin-abi@0.2.3",
  "Nanaloveyuki/image@0.1.2",
}
