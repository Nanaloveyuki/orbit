name = "Nanaloveyuki/orbit"

version = "0.3.0-alpha.1"

description = "Composable desktop application foundations for MoonBit."

repository = "https://github.com/Nanaloveyuki/orbit"

license = "Apache-2.0"

readme = "README.md"

keywords = [ "desktop", "webview", "ipc", "moonbit" ]

preferred_target = "native"

import {
  "gmlewis/sha256@0.18.3",
  "Nanaloveyuki/ajni@0.4.0",
  "Nanaloveyuki/BitLogger@0.12.0",
  "Nanaloveyuki/parsec@0.2.0",
  "Nanaloveyuki/moonview@0.2.0",
  "Nanaloveyuki/sync@0.8.0",
  "Nanaloveyuki/orby@0.2.0-beta.1",
  "Nanaloveyuki/dynlib@0.3.0",
  "Nanaloveyuki/orbit-plugin-abi@0.3.0",
  "Nanaloveyuki/image@0.2.0",
  "moonbit-community/proton_clipboard@0.10.1",
  "moonbit-community/proton_global_hotkey@0.10.1",
  "moonbit-community/proton_safe_storage@0.10.1",
  "moonbit-community/proton_shell@0.10.1",
  "moonbit-community/proton_auto_launch@0.10.1",
  "moonbit-community/proton_keepawake@0.10.1",
  "moonrockz/directories@0.1.2",
}
