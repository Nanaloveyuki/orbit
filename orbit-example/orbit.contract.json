{
  "schema_version": { "orbit": "0.1.0-alpha.11", "contract": 1 },
  "types": {
    "PingResponse": {
      "type": "object",
      "properties": { "message": { "type": "string" } },
      "required": ["message"],
      "additionalProperties": false
    },
    "Status": {
      "enum": ["idle", "running", "failed"]
    },
    "Operation": {
      "type": "tagged_union",
      "tag": "kind",
      "variants": {
        "started": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["started"] },
            "id": { "type": "string" }
          },
          "required": ["kind", "id"],
          "additionalProperties": false
        },
        "failed": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["failed"] },
            "message": { "type": "string" }
          },
          "required": ["kind", "message"],
          "additionalProperties": false
        }
      }
    }
  },
  "commands": {
    "example.ping": {
      "request": { "type": "null" },
      "response": { "$ref": "#/types/PingResponse" }
    }
  },
  "events": {
    "app.changed": {
      "type": "object",
      "properties": { "revision": { "type": "integer" } },
      "required": ["revision"],
      "additionalProperties": false
    },
    "app.operation": {
      "$ref": "#/types/Operation"
    }
  }
}

