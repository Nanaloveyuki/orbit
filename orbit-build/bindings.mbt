///|
fn bindings_source(
  config : @utils.OrbitConfig,
  fingerprint : String,
  contract? : CompiledContract? = None,
) -> String {
  let names = Json::array(page_command_names(config).map(Json::string)).stringify()
  let fingerprint = Json::string(fingerprint).stringify()
  let schema = match contract {
    Some(contract) => contract.schema.stringify()
    None => "null"
  }
  "// Generated by orbit-build. DO NOT EDIT.\nexport const configurationFingerprint = \{fingerprint};\nconst commandNames = \{names};\nconst contractSchema = \{schema};\n" +
  (
    #|function validateContract(schema, value, path = "$", depth = 0) {
    #|  if (depth > 128) throw new Error(`${path}: value nesting exceeds 128 levels`);
    #|  if (schema.$ref) return validateContract(contractSchema.types[schema.$ref.slice(8)], value, path, depth + 1);
    #|  if (schema.anyOf) { if (value === null) return; return validateContract(schema.anyOf.find(item => item.type !== "null"), value, path, depth + 1); }
    #|  if (schema.type === "tagged_union") {
    #|    if (value === null || typeof value !== "object" || Array.isArray(value)) throw new Error(`${path}: expected tagged object`);
    #|    const tag = value[schema.tag];
    #|    if (typeof tag !== "string" || !Object.hasOwn(schema.variants, tag)) throw new Error(`${path}.${schema.tag}: unknown variant`);
    #|    return validateContract(schema.variants[tag], value, path, depth + 1);
    #|  }
    #|  if (schema.enum) { if (!schema.enum.includes(value)) throw new Error(`${path}: invalid enum value`); return; }
    #|  let valid = false;
    #|  switch (schema.type) {
    #|    case "null": valid = value === null; break;
    #|    case "string": valid = typeof value === "string"; break;
    #|    case "boolean": valid = typeof value === "boolean"; break;
    #|    case "integer": valid = Number.isInteger(value) && value >= -2147483648 && value <= 2147483647; break;
    #|    case "number": valid = typeof value === "number" && Number.isFinite(value); break;
    #|    case "array":
    #|      valid = Array.isArray(value);
    #|      if (valid) for (let index = 0; index < value.length; index++) validateContract(schema.items, value[index], `${path}[${index}]`, depth + 1);
    #|      break;
    #|    case "object":
    #|      valid = value !== null && typeof value === "object" && !Array.isArray(value);
    #|      if (valid) {
    #|        if (schema.properties) {
    #|          for (const key of schema.required ?? []) if (!Object.hasOwn(value, key)) throw new Error(`${path}.${key}: missing field`);
    #|          for (const key of Object.keys(value)) {
    #|            if (!Object.hasOwn(schema.properties, key)) throw new Error(`${path}.${key}: unknown field`);
    #|            validateContract(schema.properties[key], value[key], `${path}.${key}`, depth + 1);
    #|          }
    #|        } else for (const key of Object.keys(value)) validateContract(schema.additionalProperties, value[key], `${path}.${key}`, depth + 1);
    #|      }
    #|      break;
    #|  }
    #|  if (!valid) throw new Error(`${path}: expected ${schema.type}`);
    #|}
    #|function checkContract(schema, value, code) { if (!schema) return; try { validateContract(schema, value); } catch (error) { throw new OrbitIpcError(code, error.message); } }
    #|export class OrbitIpcError extends Error {
    #|  constructor(code, message, data = null) { super(message); this.name = "OrbitIpcError"; this.code = code; this.data = data; }
    #|}
    #|function ipcError(error) {
    #|  if (error instanceof OrbitIpcError) return error;
    #|  return new OrbitIpcError(typeof error?.code === "string" ? error.code : "transport_failed", typeof error?.message === "string" ? error.message : String(error), error?.data ?? null);
    #|}
    #|export function createClient(options = {}) {
    #|  let disposed = false;
    #|  const calls = new Set();
    #|  const subscriptions = new Set();
    #|  const bridge = () => options.bridge ?? globalThis.__ORBIT__;
    #|  const requireBridge = method => {
    #|    if (disposed) throw new OrbitIpcError("client_disposed", "Orbit client was disposed");
    #|    const host = bridge();
    #|    if (!host || typeof host[method] !== "function") throw new OrbitIpcError("ipc_unavailable", `Orbit ${method} bridge is unavailable`);
    #|    return host;
    #|  };
    #|  const invoke = (command, payload = null, options = {}) => {
    #|    let host;
    #|    try { host = requireBridge("invoke"); } catch (error) { return Promise.reject(ipcError(error)); }
    #|    if (!options || typeof options !== "object") return Promise.reject(new OrbitIpcError("invalid_options", "IPC options must be an object"));
    #|    const signal = options.signal;
    #|    if (signal !== undefined && (!signal || typeof signal.aborted !== "boolean" || typeof signal.addEventListener !== "function" || typeof signal.removeEventListener !== "function")) return Promise.reject(new OrbitIpcError("invalid_signal", "signal must be an AbortSignal"));
    #|    if (signal?.aborted) return Promise.reject(new OrbitIpcError("cancelled", "IPC command was cancelled"));
    #|    const contract = contractSchema && Object.hasOwn(contractSchema.commands, command) ? contractSchema.commands[command] : undefined;
    #|    try { checkContract(contract?.request, payload, "invalid_payload"); } catch (error) { return Promise.reject(error); }
    #|    const controller = new AbortController();
    #|    const onAbort = () => controller.abort();
    #|    signal?.addEventListener("abort", onAbort, { once: true });
    #|    calls.add(controller);
    #|    return new Promise((resolve, reject) => {
    #|      const cleanup = () => { calls.delete(controller); signal?.removeEventListener("abort", onAbort); controller.signal.removeEventListener("abort", cancelled); };
    #|      const cancelled = () => { cleanup(); reject(new OrbitIpcError("cancelled", "IPC command was cancelled")); };
    #|      controller.signal.addEventListener("abort", cancelled, { once: true });
    #|      let result;
    #|      try { result = host.invoke(command, payload, { ...options, signal: controller.signal }); } catch (error) { cleanup(); reject(ipcError(error)); return; }
    #|      Promise.resolve(result).then(value => { cleanup(); try { checkContract(contract?.response, value, "invalid_response"); resolve(value); } catch (error) { reject(error); } }, error => { cleanup(); reject(ipcError(error)); });
    #|    });
    #|  };
    #|  const listen = (name, handler, options = {}) => {
    #|    const host = requireBridge("listen");
    #|    if (typeof handler !== "function") throw new TypeError("Orbit event listener must be a function");
    #|    if (!options || typeof options !== "object") throw new TypeError("Orbit listener options must be an object");
    #|    const signal = options.signal;
    #|    if (signal !== undefined && (!signal || typeof signal.aborted !== "boolean" || typeof signal.addEventListener !== "function" || typeof signal.removeEventListener !== "function")) throw new TypeError("signal must be an AbortSignal");
    #|    if (signal?.aborted) return () => {};
    #|    let active = true;
    #|    let remove;
    #|    const unlisten = () => { if (!active) return; active = false; subscriptions.delete(unlisten); signal?.removeEventListener("abort", unlisten); remove?.(); };
    #|    remove = host.listen(name, event => { if (!active) return; const schema = contractSchema?.events && Object.hasOwn(contractSchema.events, name) ? contractSchema.events[name] : undefined; checkContract(schema, event.payload, "invalid_event"); if (options.once) unlisten(); handler(event); });
    #|    if (!active) { remove(); return unlisten; }
    #|    subscriptions.add(unlisten);
    #|    signal?.addEventListener("abort", unlisten, { once: true });
    #|    if (signal?.aborted || disposed) unlisten();
    #|    return unlisten;
    #|  };
    #|  const once = (name, handler, options = {}) => listen(name, handler, { ...options, once: true });
    #|  const dispose = () => { if (disposed) return; disposed = true; for (const call of calls) call.abort(); for (const remove of Array.from(subscriptions)) remove(); };
    #|  const commands = Object.freeze(Object.fromEntries(commandNames.map(name => [name, (payload = null, options = {}) => invoke(name, payload, options)])));
    #|  return Object.freeze({ invoke, commands, listen, once, dispose, isAvailable: () => !disposed && typeof bridge()?.invoke === "function" });
    #|}
    #|const client = createClient();
    #|export const { invoke, commands, listen, once, isAvailable } = client;
    #|
  )
}

///|
fn bindings_declarations(
  config : @utils.OrbitConfig,
  contract? : CompiledContract? = None,
) -> String {
  let entries = page_command_names(config).map(command => {
    let types = match contract {
      Some(contract) => contract.commands.get(command)
      None => None
    }
    let definition = match types {
      Some((request, response)) =>
        "CommandDefinition<\{request.frontend_type}, \{response.frontend_type}>"
      None => "CommandDefinition"
    }
    "  \{Json::string(command).stringify()}: \{definition};"
  })
  let types = match contract {
    Some(contract) => contract.frontend
    None => ""
  }
  let events = match contract {
    Some(contract) =>
      contract_names(contract.events)
      .map(name => {
        "  \{contract_quote(name)}: \{contract.events[name].frontend_type};"
      })
      .join("\n")
    None => "  [name: string]: unknown;"
  }
  "// Generated by orbit-build. DO NOT EDIT.\n\{types}export interface CommandMap {\n\{entries.join("\n")}\n}\nexport interface EventMap {\n\{events}\n}\n" +
  (
    #|export interface CommandDefinition<Request = unknown, Response = unknown> { request: Request; response: Response; }
    #|export interface InvokeOptions { timeout?: number; signal?: AbortSignal; }
    #|export interface ListenOptions { signal?: AbortSignal; once?: boolean; }
    #|export type Unlisten = () => void;
    #|export interface OrbitEvent<T = unknown> { readonly name: string; readonly payload: T; readonly source: unknown; readonly target: unknown; }
    #|export class OrbitIpcError extends Error { readonly code: string; readonly data: unknown; constructor(code: string, message: string, data?: unknown); }
    #|export interface OrbitBridge {
    #|  invoke?(command: string, payload?: unknown, options?: InvokeOptions): Promise<unknown>;
    #|  listen?(name: string, handler: (event: OrbitEvent) => void): Unlisten;
    #|}
    #|export interface ClientOptions { bridge?: OrbitBridge; }
    #|export type CommandArguments<T> = null extends T ? [payload?: T, options?: InvokeOptions] : [payload: T, options?: InvokeOptions];
    #|export interface OrbitClient<C extends { [K in keyof C]: CommandDefinition }, E extends object> {
    #|  invoke<K extends keyof C & string>(command: K, ...args: CommandArguments<C[K]["request"]>): Promise<C[K]["response"]>;
    #|  readonly commands: { readonly [K in keyof C]: (...args: CommandArguments<C[K]["request"]>) => Promise<C[K]["response"]> };
    #|  listen<K extends keyof E & string>(name: K, handler: (event: OrbitEvent<E[K]>) => void, options?: ListenOptions): Unlisten;
    #|  once<K extends keyof E & string>(name: K, handler: (event: OrbitEvent<E[K]>) => void, options?: Omit<ListenOptions, "once">): Unlisten;
    #|  isAvailable(): boolean;
    #|  dispose(): void;
    #|}
    #|export function createClient<C extends { [K in keyof C]: K extends keyof CommandMap ? CommandDefinition : never } = CommandMap, E extends object = EventMap>(options?: ClientOptions): OrbitClient<C, E>;
    #|export const configurationFingerprint: string;
    #|export function invoke(command: string, payload?: unknown, options?: InvokeOptions): Promise<unknown>;
    #|export const commands: OrbitClient<CommandMap, EventMap>["commands"];
    #|export const listen: OrbitClient<CommandMap, EventMap>["listen"];
    #|export const once: OrbitClient<CommandMap, EventMap>["once"];
    #|export function isAvailable(): boolean;
    #|
  )
}
